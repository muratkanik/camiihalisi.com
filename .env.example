# Supabase PostgreSQL (Vercel'de Environment Variables olarak ekle)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-[REGION].pooler.supabase.com:5432/postgres"

# xAI Grok API (admin panel AI makale üretimi/çeviri için — birincil sağlayıcı)
XAI_API_KEY="xai-..."

# OpenRouter (XAI kredisi biterse veya hata verirse otomatik yedek sağlayıcı)
# https://openrouter.ai/keys üzerinden alınır
OPENROUTER_API_KEY="sk-or-v1-..."
# Opsiyonel — yedek olarak kullanılacak model (varsayılan: openai/gpt-4o-mini)
OPENROUTER_FALLBACK_MODEL="openai/gpt-4o-mini"

# Yönetim oturumu imzalama anahtarı (uzun, rastgele ve production'a özel)
AUTH_SECRET=""

# Site URL (production'da camiihalisi.com olarak ayarla)
NEXT_PUBLIC_SITE_URL="https://camiihalisi.com"
